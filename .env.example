# Application
APP_ENV=development
LOG_LEVEL=INFO

# LLM (Azure AI Inference)
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_MODEL=Kimi-K2.6

# OpenTelemetry — OTLP/gRPC collector (Jaeger all-in-one exposes 4317)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=mardik

# Session replay corpus
MARDIK_SESSIONS_DIR=sessions

# Observability options
# Record prompts, tool arguments and replies on spans. Personal data risk:
# keep false in production unless redaction is in place.
MARDIK_TRACE_CONTENT=false
# Metrics exporter: console (default) | otlp (collector accepting metrics) | none
MARDIK_METRICS_EXPORTER=console
# Directory where the test suite writes one JSON trace file per test (CI)
# MARDIK_TRACE_ARTIFACTS=test-artifacts/traces
