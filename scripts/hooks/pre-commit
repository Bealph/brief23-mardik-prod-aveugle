#!/usr/bin/env bash
# Refuse a commit that would publish a secret. Installed by `make hooks`.
# Blocks: any .env file except .env.example, a non-empty *_API_KEY / *_SECRET /
# *_TOKEN / *_PASSWORD assignment, and any key-like string of 60+ characters.
set -u
# A closed output pipe must not kill the hook: git would then let the commit through.
trap '' PIPE
status=0

env_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env(\..+)?$' | grep -v '\.env\.example$')
if [ -n "$env_files" ]; then
    echo "pre-commit : fichier d'environnement refusé (secrets) :" >&2
    echo "$env_files" | sed 's/^/    /' >&2
    status=1
fi

added=$(git diff --cached -U0 --no-color --diff-filter=ACMR -- . ':(exclude)*.png' ':(exclude)*.docx' | grep -E '^\+[^+]')
if echo "$added" | grep -q -E '[A-Z0-9_]*(API_KEY|SECRET|TOKEN|PASSWORD)[A-Z0-9_]*[[:space:]]*[:=][[:space:]]*["'"'"']?[^[:space:]"'"'"'#]{8,}'; then
    echo "pre-commit : une variable de secret renseignée est ajoutée (…_API_KEY=…)." >&2
    status=1
fi
if echo "$added" | grep -q -E '[A-Za-z0-9]{60,}'; then
    echo "pre-commit : chaîne de 60 caractères ou plus ressemblant à une clé." >&2
    status=1
fi

if [ "$status" -ne 0 ]; then
    echo "Commit annulé. Les accès vont dans .env, jamais suivi par git." >&2
fi
exit "$status"
